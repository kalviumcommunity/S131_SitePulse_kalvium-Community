rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isPM() {
      return isSignedIn() && getUserData().role == 'pm';
    }

    function isSupervisor(siteId) {
      return isSignedIn()
        && getUserData().role == 'supervisor'
        && getUserData().siteId == siteId;
    }

    // users: a signed-in user can read only their own doc; nobody can write.
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // sites and subcollections
    match /sites/{siteId} {
      // sites: PM and assigned supervisor can read; assigned supervisor can update ONLY lastEntryAt.
      allow read: if isPM() || isSupervisor(siteId);
      allow update: if isSupervisor(siteId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastEntryAt']);
      allow create, delete: if false;

      // workers: PM reads all; assigned supervisor can read, create and update; no deletes.
      match /workers/{workerId} {
        allow read: if isPM() || isSupervisor(siteId);
        allow create, update: if isSupervisor(siteId);
        allow delete: if false;
      }

      // attendance: PM reads all; assigned supervisor can read, create and update; no deletes.
      match /attendance/{attendanceId} {
        allow read: if isPM() || isSupervisor(siteId);
        allow create, update: if isSupervisor(siteId)
          && request.resource.data.status in ['present', 'absent', 'half'];
        allow delete: if false;
      }

      // materials: PM and assigned supervisor read; assigned supervisor can update ONLY currentStock; no create or delete from clients.
      match /materials/{materialId} {
        allow read: if isPM() || isSupervisor(siteId);
        allow update: if isSupervisor(siteId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentStock'])
          && request.resource.data.currentStock is number
          && request.resource.data.currentStock >= 0;
        allow create, delete: if false;
      }

      // materialLogs: PM and assigned supervisor read; assigned supervisor can create only (qtyUsed > 0); no update or delete.
      match /materialLogs/{logId} {
        allow read: if isPM() || isSupervisor(siteId);
        allow create: if isSupervisor(siteId)
          && request.resource.data.qtyUsed is number
          && request.resource.data.qtyUsed > 0;
        allow update, delete: if false;
      }

      // incidents: PM and assigned supervisor read; assigned supervisor can create only,
      // severity must be one of minor|moderate|high|critical and description length >= 10; no update or delete.
      match /incidents/{incidentId} {
        allow read: if isPM() || isSupervisor(siteId);
        allow create: if isSupervisor(siteId)
          && request.resource.data.severity in ['minor', 'moderate', 'high', 'critical']
          && request.resource.data.description is string
          && request.resource.data.description.size() >= 10;
        allow update, delete: if false;
      }
    }
  }
}